@model CareerManager.ViewModels.OpportunityInputModel

@{
    ViewData["Title"] = "Edit opportunity";
}

<h1>Edit opportunity</h1>
<form asp-action="Edit" asp-route-id="@ViewContext.RouteData.Values["id"]" method="post">
    <partial name="_OpportunityForm" model="Model" />
    <button type="submit" class="btn btn-primary">Save changes</button>
    <a asp-action="Details" asp-route-id="@ViewContext.RouteData.Values["id"]" class="btn btn-secondary">Cancel</a>
</form>
