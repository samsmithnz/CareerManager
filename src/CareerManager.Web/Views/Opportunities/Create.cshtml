@model CareerManager.ViewModels.OpportunityInputModel

@{
    ViewData["Title"] = "Add opportunity";
}

<h1>Add opportunity</h1>
<form asp-action="Create" method="post">
    <partial name="_OpportunityForm" model="Model" />
    <button type="submit" class="btn btn-primary">Save opportunity</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
