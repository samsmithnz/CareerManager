@model CareerManager.ViewModels.OpportunityDeleteViewModel

@{
    ViewData["Title"] = "Delete opportunity";
}

<h1>Delete opportunity</h1>
<p>Delete <strong>@Model.Opportunity.Title</strong> at <strong>@Model.Opportunity.Company</strong>?</p>

@if (Model.LinkedDocumentCount > 0)
{
    <div class="alert alert-warning" role="alert">
        This opportunity has @Model.LinkedDocumentCount saved document(s). Choose what to do with them.
    </div>
}

<form asp-action="Delete" asp-route-id="@Model.Opportunity.Id" method="post">
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    @if (Model.LinkedDocumentCount > 0)
    {
        <fieldset class="mb-3">
            <legend class="fs-6">Saved documents</legend>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="documentDisposition" id="unlinkDocuments" value="unlink"
                       checked="@(Model.DocumentDisposition == "unlink")" />
                <label class="form-check-label" for="unlinkDocuments">Keep documents and unlink them from this opportunity</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="documentDisposition" id="deleteDocuments" value="delete"
                       checked="@(Model.DocumentDisposition == "delete")" />
                <label class="form-check-label" for="deleteDocuments">Delete the documents</label>
            </div>
        </fieldset>
    }
    <button type="submit" class="btn btn-danger">Delete opportunity</button>
    <a asp-action="Details" asp-route-id="@Model.Opportunity.Id" class="btn btn-secondary">Cancel</a>
</form>
