@model CareerManager.ViewModels.ApplicationDraftEditViewModel

@{
    ViewData["Title"] = "Edit application document";
}

<h1>Edit @Model.Type</h1>
@if (Model.IsApproved)
{
    <p class="text-success">Approved @Model.ApprovedAtUtc?.ToString("u"). Saving changes returns this document to draft.</p>
}
else
{
    <p class="text-muted">Draft — saving or exporting does not approve this document.</p>
}
@if (Model.EvidenceReferences.Any(reference => reference.Missing))
{
    <div class="alert alert-warning" role="alert">
        Some referenced evidence has been removed. The saved draft text is unchanged. Review all factual claims before use.
    </div>
}
<section class="mb-3">
    <h2 class="h5">Evidence references</h2>
    @if (Model.EvidenceReferences.Count == 0)
    {
        <p>No evidence references are attached.</p>
    }
    else
    {
        <ul>
            @foreach (var reference in Model.EvidenceReferences)
            {
                <li>
                    @if (reference.Missing)
                    {
                        <span class="text-danger">Evidence #@reference.Id was removed; review linked claims.</span>
                    }
                    else
                    {
                        <span>@reference.Title (evidence #@reference.Id)</span>
                    }
                </li>
            }
        </ul>
    }
</section>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <input asp-for="Input.ConcurrencyToken" type="hidden" />
    <div class="mb-3">
        <label asp-for="Input.Title" class="form-label"></label>
        <input asp-for="Input.Title" class="form-control" />
        <span asp-validation-for="Input.Title" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Text" class="form-label">Draft text</label>
        <textarea asp-for="Input.Text" rows="18" class="form-control"></textarea>
        <span asp-validation-for="Input.Text" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save draft</button>
    <a asp-action="Index" asp-route-opportunityId="@Model.OpportunityId" class="btn btn-secondary">Cancel</a>
</form>
@if (Model.CanExport)
{
    <section class="mt-4">
        <h2 class="h5">Review and export the saved version</h2>
        <p>Saving or downloading never counts as approval. Evidence references do not prove factual claims.</p>
        <a asp-action="Review" asp-route-id="@Model.Id" class="btn btn-outline-primary">Review factual claims</a>
        <a asp-action="Export" asp-route-id="@Model.Id" asp-route-format="pdf"
           asp-route-concurrencyToken="@Model.Input.ConcurrencyToken" class="btn btn-outline-secondary">Download PDF</a>
        <a asp-action="Export" asp-route-id="@Model.Id" asp-route-format="docx"
           asp-route-concurrencyToken="@Model.Input.ConcurrencyToken" class="btn btn-outline-secondary">Download DOCX</a>
    </section>
}
