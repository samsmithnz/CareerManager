@model CareerManager.ViewModels.ApplicationDraftIndexViewModel

@{
    ViewData["Title"] = "Application drafts";
}

<h1>Application drafts</h1>
<p>Generated documents remain editable. Saving or downloading never counts as approval; review every factual claim before use.</p>

@if (Model.Drafts.Count == 0)
{
    <p>No saved documents.</p>
}
else
{
    @foreach (var row in Model.Drafts)
    {
        <article class="card mb-3">
            <div class="card-body">
                <h2 class="h5">@row.Document.Title</h2>
                <p class="text-muted">
                    @row.Document.Type ·
                    @if (row.IsApproved)
                    {
                        <span class="text-success">Approved @row.Document.ApprovedAtUtc?.ToString("u")</span>
                    }
                    else
                    {
                        <span>Draft</span>
                    }
                    · Updated @row.Document.UpdatedAtUtc.ToString("u")
                </p>
                @if (row.MissingEvidenceCount > 0)
                {
                    <p class="alert alert-warning" role="alert">
                        @row.MissingEvidenceCount referenced evidence item(s) were removed. The saved text is unchanged; review its factual claims.
                    </p>
                }
                @if (row.EvidenceTitles.Count > 0)
                {
                    <p>Evidence references: @string.Join(", ", row.EvidenceTitles)</p>
                }
                <pre class="text-wrap">@row.Document.Text</pre>
                <a asp-action="Edit" asp-route-id="@row.Document.Id" class="btn btn-primary">Edit document</a>
                @if (row.Document.Type is CareerManager.Models.CareerDocumentType.Resume or CareerManager.Models.CareerDocumentType.CoverLetter)
                {
                    <a asp-action="Review" asp-route-id="@row.Document.Id" class="btn btn-outline-primary">Review factual claims</a>
                    <a asp-action="Export" asp-route-id="@row.Document.Id" asp-route-format="pdf"
                       asp-route-concurrencyToken="@row.Document.ConcurrencyToken" class="btn btn-outline-secondary">Download PDF</a>
                    <a asp-action="Export" asp-route-id="@row.Document.Id" asp-route-format="docx"
                       asp-route-concurrencyToken="@row.Document.ConcurrencyToken" class="btn btn-outline-secondary">Download DOCX</a>
                }
            </div>
        </article>
    }
}
