@model CareerManager.ViewModels.CareerPlanGenerationReviewViewModel

@{
    ViewData["Title"] = "Review career plan generation";
}

<h1>Review career plan generation</h1>
<p>Review exactly the information that will be processed. Generation will not change your saved plan. A generated result must be reviewed and explicitly replaced.</p>

@if (Model.SendsDataExternally)
{
    <p class="alert alert-warning" role="alert">
        This request will send the listed information to @Model.ProviderName using deployment @Model.ModelName in @Model.Region.
        No other career content is included.
    </p>
}
else
{
    <p>This uses the local provider @Model.ProviderName (@Model.ModelName) in the application deployment region; nothing is sent to an external AI service.</p>
}

<section class="mb-4">
    <h2 class="h5">Planning information to be processed</h2>
    <dl>
        <dt>Target roles</dt>
        <dd><pre class="text-wrap">@Model.Plan.TargetRoles</pre></dd>
        <dt>Strengths</dt>
        <dd><pre class="text-wrap">@Model.Plan.Strengths</pre></dd>
        <dt>Interests</dt>
        <dd><pre class="text-wrap">@Model.Plan.Interests</pre></dd>
    </dl>
</section>

<section class="mb-4">
    <h2 class="h5">Selected factual evidence</h2>
    @if (Model.SelectedEvidence.Count == 0)
    {
        <p>No evidence will be processed. Any resulting gaps are suggestions, not factual claims.</p>
    }
    @foreach (var entry in Model.SelectedEvidence)
    {
        <article class="border rounded p-3 mb-2">
            <h3 class="h6">@entry.Category: @entry.Title</h3>
            @if (entry.StartDate.HasValue || entry.EndDate.HasValue)
            {
                <p>Dates: @entry.StartDate?.ToString("yyyy-MM-dd") – @entry.EndDate?.ToString("yyyy-MM-dd")</p>
            }
            <dl class="mb-0">
                <dt>Context</dt><dd>@entry.Context</dd>
                @if (entry.Contribution is not null)
                {
                    <dt>My contribution</dt><dd>@entry.Contribution</dd>
                }
                @if (entry.Outcome is not null)
                {
                    <dt>Outcome</dt><dd>@entry.Outcome</dd>
                }
                @if (entry.Metric is not null)
                {
                    <dt>Metric</dt><dd>@entry.Metric</dd>
                }
                @if (entry.Tags is not null)
                {
                    <dt>Tags</dt><dd>@entry.Tags</dd>
                }
                @if (entry.SourceNote is not null)
                {
                    <dt>Source note</dt><dd>@entry.SourceNote</dd>
                }
                @if (entry.SourceUrl is not null)
                {
                    <dt>Source URL</dt><dd><a href="@entry.SourceUrl" rel="noopener noreferrer">@entry.SourceUrl</a></dd>
                }
            </dl>
        </article>
    }
</section>

<form asp-action="Generate" asp-route-id="@Model.Plan.Id" method="post">
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <input type="hidden" name="PreviewToken" value="@Model.PreviewToken" />
    <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" name="Consent" value="true" id="planGenerationConsent"
               checked="@(Model.Consent ? "checked" : null)" />
        <label class="form-check-label" for="planGenerationConsent">
            I reviewed the target roles, strengths, interests, and selected evidence above and consent to processing only those items for career planning.
        </label>
    </div>
    <p class="text-muted">Generated gaps and recommendations remain suggestions. They are never written into factual career records or approved automatically.</p>
    <button class="btn btn-primary" type="submit">Consent and generate review</button>
    <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Plan.Id">Cancel</a>
</form>
